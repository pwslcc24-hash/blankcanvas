{
  "name": "PaperTrade",
  "type": "object",
  "description": "One simulated trade for a strategy on a consensus signal. Realistic entry assumes delay + slippage + fees; exit uses redemption/resolution when available.",
  "properties": {
    "strategy_id": {
      "type": "string",
      "description": "PaperStrategy preset key"
    },
    "trade_key": {
      "type": "string",
      "description": "Dedupe key: strategy_id|signal_key"
    },
    "signal_key": {
      "type": "string",
      "description": "Consensus signal that triggered this trade"
    },
    "condition_id": {
      "type": "string",
      "description": "Market condition ID"
    },
    "market_title": {
      "type": "string",
      "description": "Market title at entry"
    },
    "market_slug": {
      "type": "string",
      "description": "Polymarket event/market slug for linking"
    },
    "outcome": {
      "type": "string",
      "description": "Outcome label bought"
    },
    "outcome_index": {
      "type": "integer",
      "description": "Outcome index bought"
    },
    "wallet_count": {
      "type": "integer",
      "description": "Skilled wallets in consensus at signal time"
    },
    "participants_json": {
      "type": "string",
      "description": "JSON array of wallets that triggered the signal (address, label, grade, price, usdc_size, occurred_at)"
    },
    "status": {
      "type": "string",
      "enum": ["open", "won", "lost", "expired"],
      "description": "open = awaiting resolution; won/lost = resolved; expired = stale open"
    },
    "signal_at": {
      "type": "string",
      "format": "date-time",
      "description": "When consensus last buy occurred"
    },
    "entry_at": {
      "type": "string",
      "format": "date-time",
      "description": "Simulated entry time (signal + detection delay)"
    },
    "entry_price": {
      "type": "number",
      "description": "Simulated fill price (0-1) after slippage"
    },
    "stake_usd": {
      "type": "number",
      "description": "Notional USDC deployed"
    },
    "fee_usd": {
      "type": "number",
      "description": "Trading fee deducted at entry"
    },
    "shares": {
      "type": "number",
      "description": "Shares bought after fees"
    },
    "vwap_skilled_entry": {
      "type": "number",
      "description": "Skilled wallets' VWAP before our simulated slippage"
    },
    "exit_at": {
      "type": "string",
      "format": "date-time",
      "description": "When market resolved or position closed"
    },
    "exit_price": {
      "type": "number",
      "description": "Exit price (0 or 1 for binary resolution, or mark price)"
    },
    "pnl_usd": {
      "type": "number",
      "description": "Realized profit/loss in USD"
    },
    "is_backtest": {
      "type": "boolean",
      "description": "True if generated by historical backtest; false if forward paper trade"
    }
  },
  "required": ["strategy_id", "trade_key", "signal_key", "condition_id", "status", "entry_at", "entry_price", "stake_usd"],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}
